# LLM Provider Configuration
# Set to 'openrouter', 'openai', 'gemini', or 'mock'
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary LLM Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional Legacy Providers (for backward compatibility)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embedding Configuration (huggingface, openai, gemini)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Hyperparameters (Optional)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=100
# TOP_K=5

# Directories (Optional)
# UPLOAD_DIR=uploads
# FAISS_DB_DIR=faiss_db
# MAX_FILE_SIZE_MB=100

# MongoDB & Multi-tenant Configurations
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=documind_ai
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-12345
FIREBASE_PROJECT_ID=documind-ai-88e8e
