# LLM Provider Configuration
# Set to 'openai' or 'gemini'
LLM_PROVIDER=openai

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Model Overrides (Optional - defaults are pre-configured in app/config.py)
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_LLM_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Embedding Configuration (openai, gemini, huggingface)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Hyperparameters (Optional)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=100
# TOP_K=5

# Directories (Optional)
# UPLOAD_DIR=uploads
# FAISS_DB_DIR=faiss_db
# MAX_FILE_SIZE_MB=10

# MongoDB & Multi-tenant Configurations
MONGODB_URI=
DATABASE_NAME=documind_ai
JWT_SECRET_KEY=
FIREBASE_PROJECT_ID=

